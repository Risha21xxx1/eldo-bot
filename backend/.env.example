# Environment Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./eldorado.db

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO

# Extension Connection
EXTENSION_SECRET_KEY=change-this-to-a-random-secret-key
